# SIH PS 26145: Cyber Threat Detector Environment Configuration
# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cyber_threats

# FastAPI Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Traffic Context
TRAFFIC_CONTEXT_DEFAULT=UNLABELED_LIVE

# ==============================================================================
# Security & Authentication Configuration
# ==============================================================================
# Secret key used for signing JWT tokens (Generate a random 64-char key in production)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production

# JWT algorithm (HS256 is default)
JWT_ALGORITHM=HS256

# Session expiration time in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie security: Set to True in production with HTTPS / TLS.
# Set to False only for local HTTP development (localhost / 127.0.0.1).
SESSION_COOKIE_SECURE=False

# Cookie SameSite policy: 'lax', 'strict', or 'none' (default: 'lax')
SESSION_COOKIE_SAMESITE=lax

# ==============================================================================
# Remote Sensor & Telemetry Ingestion Configuration
# ==============================================================================
# Server-side salt used for hashing sensor API keys (SHA-256)
SENSOR_API_KEY_SALT=change_this_to_a_secure_random_salt_in_production

# Ingestion rate limits (requests per minute per sensor)
SENSOR_INGEST_RATE_LIMIT_PER_MINUTE=60

# Local Sensor Client Configuration (for reviewer machines running scripts/run_sensor.py)
# THREATTRACK_BACKEND_URL=https://threattrack-api.yourdomain.com
# THREATTRACK_SENSOR_API_KEY=netra_live_your_enrolled_credential_here
# NETRA_BACKEND_URL=https://threattrack-api.yourdomain.com
# NETRA_SENSOR_API_KEY=netra_live_your_enrolled_credential_here
